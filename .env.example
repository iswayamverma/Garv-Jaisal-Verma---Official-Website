# Copy this file to .env.local and fill in real values.
# Nothing in this file should ever be committed with real secrets.

# --- Site ---
# Canonical production URL, no trailing slash. Used for metadataBase,
# canonical links, sitemap.xml and JSON-LD (PDD §38).
NEXT_PUBLIC_SITE_URL=https://www.garvjaisalverma.com

# --- Cloudinary (PDD §4.2) ---
# Required for real photos/artwork/video thumbnails to render via CldImage.
# Until this is set, every media slot renders the site's built-in
# placeholder treatment instead of attempting to load an image.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=

# --- Contact form email delivery (PDD §27a) ---
# API key for the transactional email provider. Defaults to Resend
# (https://resend.com) — see lib/email.ts to swap providers.
EMAIL_PROVIDER_API_KEY=
# Inbox that booking/collab/production/media inquiries should land in.
CONTACT_TO_EMAIL=[BOOKING_EMAIL]
# "From" address used when sending — must be a domain verified with your
# email provider before it will deliver in production.
CONTACT_FROM_EMAIL="Garv Jaisal Verma Site <onboarding@resend.dev>"
